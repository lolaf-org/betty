<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.lolaf.betty</groupId>
    <artifactId>betty-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Betty</name>
    <description>
        Asynchronous NIO networking for low-latency Java: clients, servers, SSL and pluggable select strategies.
    </description>
    <url>https://github.com/lolaf-org/betty</url>
    <inceptionYear>2024-2026</inceptionYear>
    <organization>
        <name>Lolaf</name>
        <url>https://www.lolaf.org</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>cmunger</id>
            <name>Cedric Munger</name>
            <url>https://github.com/cmunger</url>
            <organization>Lolaf.org</organization>
            <organizationUrl>https://www.lolaf.org</organizationUrl>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds. A literal instant, never a variable reference: the pom is deployed
             to Central exactly as written on disk, and maven-release-plugin moves this in the same
             commit as the version. -->
        <project.build.outputTimestamp>2026-09-01T19:13:51Z</project.build.outputTimestamp>
        <!-- release, not source/target: nothing in betty reaches a java.base internal at compile
             time, so javac's release flag is available everywhere and a jar cannot pick up a
             post-11 method that would NoSuchMethodError on a real JDK 11. (Two dashes cannot
             appear inside an XML comment, which is why the flag is named in prose here.) -->
        <maven.compiler.release>11</maven.compiler.release>

        <ringos.version>0.2.0-SNAPSHOT</ringos.version>

        <slf4j.version>2.0.17</slf4j.version>
        <jmh.version>1.37</jmh.version>
        <mockito.version>5.23.0</mockito.version>
        <junit.version>6.1.3</junit.version>
        <lombok.version>1.18.46</lombok.version>
        <assertj-core.version>3.27.7</assertj-core.version>
        <awaitility.version>4.3.0</awaitility.version>

        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <!-- Appended to what maven-release-plugin passes to its forked builds. It exists because
             <arguments> below is set in the pom, which makes -Darguments= on the command line a
             silently ignored no-op. -->
        <release.extraArguments/>
        <lombok-maven-plugin.version>1.18.20.0</lombok-maven-plugin.version>
        <license-maven-plugin.version>5.1.2</license-maven-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>

        <!-- Assembled once here so a module can add to it without restating it. A module must never
             declare its own <argLine>: that replaces this set wholesale and the pieces left out
             disappear silently. Add through surefire.argLine.extra instead. -->
        <surefire.argLine>
            -XX:ContendedPaddingWidth=64
            -XX:-RestrictContended
            --enable-native-access=ALL-UNNAMED
            --add-opens java.base/jdk.internal.misc=ALL-UNNAMED
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens java.base/java.nio=ALL-UNNAMED
            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
            -Xshare:off
            ${surefire.argLine.extra}
        </surefire.argLine>
        <surefire.argLine.extra/>
        <automatic.module.name>org.lolaf.betty.MODULE.NAME.NOT.SET</automatic.module.name>
        <license.source.dir>${project.basedir}/..</license.source.dir>
        <delombok.skip>false</delombok.skip>
        <javadoc.delomboked.sources>${project.build.directory}/delombok</javadoc.delomboked.sources>
        <javadoc.sourcepath>${javadoc.delomboked.sources}</javadoc.sourcepath>
    </properties>

    <modules>
        <module>api</module>
        <module>impl</module>
        <module>benchmarks</module>
        <module>module-path-test</module>
    </modules>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/lolaf-org/betty.git</connection>
        <developerConnection>scm:git:https://github.com/lolaf-org/betty.git</developerConnection>
        <url>https://github.com/lolaf-org/betty</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/lolaf-org/betty/issues</url>
    </issueManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.openjdk.jmh</groupId>
                                <artifactId>jmh-generator-annprocess</artifactId>
                                <version>${jmh.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>default-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <archive>
                                    <manifest>
                                        <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                        <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                                    </manifest>
                                    <manifestEntries>
                                        <Built-By>Lolaf</Built-By>
                                        <Implementation-URL>https://github.com/lolaf-org/betty</Implementation-URL>
                                        <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                                    </manifestEntries>
                                </archive>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok-maven-plugin</artifactId>
                    <version>${lombok-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <skip>${delombok.skip}</skip>
                        <addOutputDirectory>false</addOutputDirectory>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                        <outputDirectory>${javadoc.delomboked.sources}</outputDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <failOnError>true</failOnError>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <detectOfflineLinks>false</detectOfflineLinks>
                        <quiet>true</quiet>
                        <sourcepath>${javadoc.sourcepath}</sourcepath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>${surefire.argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>release</releaseProfiles>
                        <!-- release:perform otherwise sets performRelease=true, which activates
                             release-profile from Maven's super-POM - still present in 3.8.7 - and that
                             profile attaches a sources jar and a javadoc jar of its own, under the
                             execution ids attach-sources and attach-javadocs. Ours are source-jar and
                             javadoc-jar, so the ids do not merge and both would fire: two
                             -sources.jar and two -javadoc.jar attached per module. -->
                        <useReleaseProfile>false</useReleaseProfile>
                        <arguments>-T1C ${release.extraArguments}</arguments>
                        <scmReleaseCommitComment>release @{releaseLabel}</scmReleaseCommitComment>
                        <scmDevelopmentCommitComment>resume development after @{releaseLabel}</scmDevelopmentCommitComment>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>delombok-for-javadoc</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>delombok</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>${project.basedir}/HEADER.txt</header>
                            <excludes>
                                <exclude>**/LICENSE.txt</exclude>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.yaml</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.sh</exclude>
                                <exclude>**/*.json</exclude>
                                <exclude>**/*.md</exclude>
                                <exclude>**/mvnw</exclude>
                                <exclude>**/.mvn/**</exclude>
                                <exclude>**/pom.xml</exclude>
                                <exclude>**/src/main/resources/**</exclude>
                                <exclude>**/src/test/resources/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>source-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-license-into-the-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${license.source.dir}</directory>
                                    <includes>
                                        <include>LICENSE.txt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <allowMajorUpdates>false</allowMajorUpdates>
                    <dependencyExcludes>org.slf4j:*</dependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>Maven 3.6.3 or newer is required: older versions ignore the child.*.inherit.append.path attributes the published poms rely on.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>Building betty needs JDK 17 or newer (JUnit 6 requires 17, and --enable-native-access is rejected by 16 and older). The library itself still runs on JDK 11.</message>
                                </requireJavaVersion>
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                    <message>A release may not depend on a SNAPSHOT: Central rejects the bundle, and the artifact would be unbuildable once that snapshot moved. Betty cannot be released until ringos is.</message>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- keyname comes from a CI secret, passed as -Dgpg.keyname -->
                            <bestPractices>true</bestPractices>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- The <server> id in settings.xml holding the Portal token. -->
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload and validate, do not publish automatically: a published
                                 version can never be replaced or reused. -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- maven.deploy.skip is a maven-deploy-plugin property, and this plugin replaces that plugin -->
                            <excludeArtifacts>
                                <excludeArtifact>betty-benchmarks</excludeArtifact>
                                <excludeArtifact>betty-module-path-test</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
